<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Listed Properties - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    .property-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .property-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    .property-img {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: calc(0.375rem - 1px);
      border-top-right-radius: calc(0.375rem - 1px);
    }
    .status-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
    .delete-btn {
      color: var(--danger);
      border-color: var(--danger);
      transition: all 0.2s ease-in-out;
    }
    .delete-btn:hover {
      background-color: var(--danger);
      color: white;
      transform: translateY(-2px);
    }
    .modal-header-danger {
      background-color: var(--danger);
      color: white;
    }
    
    /* Fix modal positioning issues */
    .modal {
      position: fixed !important;
      left: 0 !important;
      right: 0 !important;
      top: 0 !important;
      bottom: 0 !important;
      margin: 0 auto !important;
      overflow-y: auto !important;
      z-index: 1050 !important;
      background-color: rgba(0,0,0,0.5) !important;
    }
    
    .modal-dialog {
      margin: 1.75rem auto !important;
      transform: none !important;
    }
    
    /* Remove default backdrop */
    .modal-backdrop {
      display: none !important;
      opacity: 0 !important;
      z-index: -1 !important;
    }
    
  </style>
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>

  <!-- Notification Messages -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 1060">
    <div class="toast show bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="bi bi-check-circle-fill me-2"></i><%= successMessage %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
  <% } %>
  
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 1060">
    <div class="toast show bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
  <% } %>

  <div class="container py-5">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-3 mb-4 animate_animated animate_fadeIn">
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-body p-4">
            <div class="text-center mb-4">
              <div class="avatar-circle mx-auto mb-3">
                <i class="bi bi-person-circle display-1 text-primary"></i>
              </div>
              <h5 class="fw-bold mb-1">Seller Dashboard</h5>
            </div>
            
            <div class="list-group list-group-flush mt-4">
              <a href="/seller/dashboard" class="list-group-item list-group-item-action py-3">
                <i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard
              </a>
              <a href="/seller/profile" class="list-group-item list-group-item-action py-3">
                <i class="bi bi-person me-2 text-primary"></i>My Profile
              </a>
              <a href="/seller/add-property" class="list-group-item list-group-item-action py-3">
                <i class="bi bi-plus-circle me-2 text-primary"></i>Add Property
              </a>
              <a href="/seller/listed-properties" class="list-group-item list-group-item-action py-3 active">
                <i class="bi bi-houses me-2"></i>My Properties
              </a>
              <a href="/logout" class="list-group-item list-group-item-action py-3">
                <i class="bi bi-box-arrow-right me-2 text-primary"></i>Logout
              </a>
            </div>
            
            <div class="d-grid mt-4">
              <a href="/seller/add-property" class="btn btn-primary hover-transform">
                <i class="bi bi-plus-circle me-2"></i>Add New Property
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Main Content -->
      <div class="col-lg-9 animate_animated animate_fadeInRight">
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
              <h4 class="fw-bold mb-0">
                <i class="bi bi-buildings me-2 text-primary"></i>My Listed Properties
              </h4>
              <div>
                <select class="form-select form-select-sm" id="statusFilter">
                  <option value="all">All Properties</option>
                  <option value="approved">Approved</option>
                  <option value="pending">Pending</option>
                </select>
              </div>
            </div>
          </div>
          
          <div class="card-body p-4">
            <% if (properties.length > 0) { %>
              <div class="row g-4">
                <% properties.forEach(property => { %>
                  <div class="col-md-6 col-lg-4 property-item animate_animated animate_fadeIn" data-status="<%= property.status.toLowerCase() %>">
                    <div class="card property-card border-0 shadow-sm h-100">
                      <div class="position-relative">
                        <img src="<%= property.images[0] !== 'none' ? property.images[0] : 'https://via.placeholder.com/400x200?text=No+Image' %>" 
                             class="property-img w-100" alt="<%= property.title %>">
                        <span class="badge status-badge bg-<%= property.status === 'Approved' ? 'success' : 'warning' %>">
                          <i class="bi bi-<%= property.status === 'Approved' ? 'check-circle' : 'clock' %> me-1"></i>
                          <%= property.status %>
                        </span>
                      </div>
                      
                      <div class="card-body p-3">
                        <h5 class="card-title fw-bold mb-2 text-truncate"><%= property.title %></h5>
                        <p class="card-text mb-1 text-muted">
                          <i class="bi bi-geo-alt-fill me-1"></i><%= property.location %>
                        </p>
                        <p class="card-text fw-semibold text-primary mb-2">₹<%= property.price.toLocaleString() %></p>
                        
                        <div class="d-flex mt-3 pt-3 border-top">
                          <a href="/property/<%= property._id %>" class="btn btn-sm btn-outline-primary me-2">
                            <i class="bi bi-eye me-1"></i>View
                          </a>
                          <button class="btn btn-sm btn-outline-danger delete-btn action-btn" 
                                  data-bs-toggle="modal" 
                                  data-bs-target="#deletePropertyModal<%= property._id %>">
                            <i class="bi bi-trash me-1"></i>Delete
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Delete Property Modal -->
<div class="modal" id="deletePropertyModal<%= property._id %>" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:1050;" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered" style="margin:10% auto; max-width:500px;">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header modal-header-danger">
        <h5 class="modal-title" id="deletePropertyModalLabel<%= property._id %>">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
        </h5>
        <button type="button" class="btn-close btn-close-white close-modal" data-property-id="<%= property._id %>" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body">
        <p>Are you sure you want to delete "<strong><%= property.title %></strong>"?</p>
        <p class="text-danger">
          <i class="bi bi-exclamation-circle me-1"></i>The images and property details will be permanently deleted.
        </p>
      </div>

      <!-- Modal Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary close-modal" data-property-id="<%= property._id %>">Cancel</button>
        <button type="button" class="btn btn-danger delete-property-btn" data-property-id="<%= property._id %>">
          <i class="bi bi-trash me-1"></i>Delete
        </button>
      </div>
    </div>
  </div>
</div>

                <% }) %>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-house-x display-1 text-muted mb-3"></i>
                <h5 class="fw-bold mb-2">No Properties Listed Yet</h5>
                <p class="text-muted mb-4">You haven't listed any properties at this time.</p>
                <a href="/seller/add-property" class="btn btn-primary px-4 py-2 hover-transform">
                  <i class="bi bi-plus-circle me-2"></i>Add Your First Property
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-primary">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/scripts.js"></script>
  <script>
    // Remove existing modal backdrops
    function removeModalBackdrops() {
      document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
        backdrop.remove();
      });
    }
    
    // Run on page load to remove any existing backdrops
    document.addEventListener('DOMContentLoaded', function() {
      // First remove any existing backdrops
      removeModalBackdrops();
      
      // Override Bootstrap modal backdrop function
      if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        const originalModal = bootstrap.Modal;
        bootstrap.Modal = function(element, options) {
          options = options || {};
          options.backdrop = false;
          return new originalModal(element, options);
        };
      }
      
      // Show modal function
      function showModal(modalId) {
        document.getElementById(modalId).style.display = 'block';
        document.body.style.overflow = 'hidden';
      }
      
      // Hide modal function
      function hideModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
        document.body.style.overflow = '';
      }
      
      // Add click event for delete buttons
      const deleteButtons = document.querySelectorAll('.delete-btn');
      deleteButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          const targetModal = this.getAttribute('data-bs-target').substring(1);
          showModal(targetModal);
        });
      });
      
      // Add click event for close buttons
      const closeButtons = document.querySelectorAll('.close-modal');
      closeButtons.forEach(button => {
        button.addEventListener('click', function() {
          const propertyId = this.getAttribute('data-property-id');
          hideModal('deletePropertyModal' + propertyId);
        });
      });
      
      // Handle property deletion with AJAX
      const deletePropertyButtons = document.querySelectorAll('.delete-property-btn');
      deletePropertyButtons.forEach(button => {
        button.addEventListener('click', function() {
          const propertyId = this.getAttribute('data-property-id');
          // Disable the button to prevent multiple clicks
          this.disabled = true;
          this.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Deleting...';
          
          // Create the fetch request
          fetch('/seller/delete-property/' + propertyId, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            }
          })
          .then(response => {
            if (response.ok) {
              // Hide the modal
              hideModal('deletePropertyModal' + propertyId);
              
              // Remove the property card from the UI
              const propertyCard = document.querySelector(`.property-item[data-status="${propertyId}"]`);
              if (propertyCard) {
                propertyCard.style.opacity = '0';
                setTimeout(() => {
                  propertyCard.remove();
                  // If no more properties, show the empty state
                  if (document.querySelectorAll('.property-item').length === 0) {
                    location.reload(); // Reload to show the empty state
                  }
                }, 300);
              } else {
                // If we can't find the card, reload the page
                location.reload();
              }
              
              // Show toast notification
              const toast = document.createElement('div');
              toast.className = 'position-fixed top-0 end-0 p-3';
              toast.style.zIndex = '1060';
              toast.innerHTML = `
                <div class="toast show bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
                  <div class="d-flex">
                    <div class="toast-body">
                      <i class="bi bi-check-circle-fill me-2"></i>Property deleted successfully
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                  </div>
                </div>
              `;
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
            } else {
              // Show error toast
              const toast = document.createElement('div');
              toast.className = 'position-fixed top-0 end-0 p-3';
              toast.style.zIndex = '1060';
              toast.innerHTML = `
                <div class="toast show bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
                  <div class="d-flex">
                    <div class="toast-body">
                      <i class="bi bi-exclamation-triangle-fill me-2"></i>Error deleting property
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                  </div>
                </div>
              `;
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
              
              // Re-enable the button
              this.disabled = false;
              this.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
              
              // Hide the modal
              hideModal('deletePropertyModal' + propertyId);
            }
          })
          .catch(error => {
            console.error('Error deleting property:', error);
            
            // Show error toast
            const toast = document.createElement('div');
            toast.className = 'position-fixed top-0 end-0 p-3';
            toast.style.zIndex = '1060';
            toast.innerHTML = `
              <div class="toast show bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                  <div class="toast-body">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Error deleting property
                  </div>
                  <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
              </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
            
            // Re-enable the button
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
            
            // Hide the modal
            hideModal('deletePropertyModal' + propertyId);
          });
        });
      });
      
      // Property status filter functionality
      document.getElementById('statusFilter').addEventListener('change', function() {
        const filterValue = this.value;
        const propertyItems = document.querySelectorAll('.property-item');
        
        propertyItems.forEach(item => {
          if (filterValue === 'all' || item.dataset.status === filterValue) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
      
      // Add a mutation observer to remove any modal backdrops that might be added
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.addedNodes.length) {
            for (let i = 0; i < mutation.addedNodes.length; i++) {
              const node = mutation.addedNodes[i];
              if (node.classList && node.classList.contains('modal-backdrop')) {
                node.remove();
              }
            }
          }
        });
      });
      
      // Start observing the document for modal backdrop additions
      observer.observe(document.body, { childList: true, subtree: true });
      
      // Close modal when clicking outside
      const modals = document.querySelectorAll('.modal');
      modals.forEach(modal => {
        modal.addEventListener('click', function(e) {
          if (e.target === this) {
            this.style.display = 'none';
            document.body.style.overflow = '';
            removeModalBackdrops(); // Clean up any backdrops
          }
        });
      });
    });
  </script>
</body>
</html>