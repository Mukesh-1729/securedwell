<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seller Dashboard - SecureDwell</title>
  <%- include('../partials/header') %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <style>
    :root {
      --gold-primary: #d4af37;
      --gold-secondary: #f9d776;
      --gold-light: #f8e7b2;
      --gold-dark: #a17c1a;
      --gold-hover: #e5c158;
    }
    
    .text-gold {
      color: var(--gold-primary) !important;
    }
    
    .bg-gold {
      background-color: var(--gold-primary) !important;
    }
    
    .btn-gold {
      background-color: var(--gold-primary);
      border-color: var(--gold-primary);
      color: #fff;
    }
    
    .btn-gold:hover, .btn-gold:focus {
      background-color: var(--gold-hover);
      border-color: var(--gold-hover);
      color: #fff;
    }
    
    .btn-outline-gold {
      background-color: transparent;
      border-color: var(--gold-primary);
      color: var(--gold-primary);
    }
    
    .btn-outline-gold:hover, .btn-outline-gold:focus {
      background-color: var(--gold-primary);
      color: #fff;
    }
    
    .sidebar {
      background: linear-gradient(180deg, #2c2c2c 0%, #1a1a1a 100%) !important;
    }
    
    .sidebar .list-group-item {
      background-color: transparent !important;
      color: #f8f9fa;
      border-color: rgba(255, 255, 255, 0.1) !important;
      transition: all 0.3s ease;
    }
    
    .sidebar .list-group-item:hover {
      background-color: rgba(212, 175, 55, 0.15) !important;
      color: var(--gold-secondary);
    }
    
    .sidebar .list-group-item.active {
      background-color: rgba(212, 175, 55, 0.25) !important;
      color: var(--gold-secondary);
      border-left: 4px solid var(--gold-primary);
    }
    
    .sidebar .list-group-item i {
      color: var(--gold-primary);
    }
    
    .hover-card {
      transition: all 0.3s ease;
    }
    
    .hover-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }
    
    .hover-transform {
      transition: all 0.3s ease;
    }
    
    .hover-transform:hover {
      transform: translateY(-2px);
    }
    
    .feature-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background-color: rgba(212, 175, 55, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }
    
    .avatar-circle {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: rgba(212, 175, 55, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
  </style>
</head>
<body class="bg-light">
  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-3 col-xl-2 px-0 sidebar position-fixed vh-100 animate__animated animate__fadeIn">
        <div class="d-flex flex-column h-100 p-3">
          <div class="text-center mb-4 py-3">
            <h4 class="text-white mb-0">
              <i class="bi bi-house-check me-2 text-gold"></i>
              SecureDwell
            </h4>
          </div>
          
          <div class="list-group list-group-flush rounded-3 mb-4">
            <div class="list-group-item py-3 border-0">
              <i class="bi bi-person-circle text-gold me-2"></i>
              <span>Welcome, <%= user.name %></span>
            </div>
          </div>
          
          <h6 class="text-uppercase text-white-50 px-3 mt-3 mb-2">Seller Menu</h6>
          <div class="list-group list-group-flush rounded-3">
            <a href="/seller/dashboard" class="list-group-item list-group-item-action active py-3 fw-semibold">
              <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="/seller/profile" class="list-group-item list-group-item-action py-3 fw-semibold">
              <i class="bi bi-person me-2"></i>My Profile
            </a>
            <a href="/seller/add-property" class="list-group-item list-group-item-action py-3 fw-semibold">
              <i class="bi bi-plus-circle me-2"></i>Add Property
            </a>
            <a href="/seller/listed-properties" class="list-group-item list-group-item-action py-3 fw-semibold">
              <i class="bi bi-houses me-2"></i>My Properties
            </a>
            <a href="/property/listings" class="list-group-item list-group-item-action py-3 fw-semibold">
              <i class="bi bi-building me-2"></i>Browse All Listings
            </a>
          </div>
          
          <div class="mt-auto">
            <a href="/logout" class="btn btn-outline-gold w-100 hover-transform">
              <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
          </div>
        </div>
      </div>
      
      <!-- Main Content -->
      <div class="col-lg-9 col-xl-10 ms-auto py-4 px-4 animate__animated animate__fadeInRight">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
          <h2 class="h3 fw-bold mb-0">Seller Dashboard</h2>
          <div class="text-end">
            <span class="badge bg-gold p-2 rounded-pill">Seller Account</span>
          </div>
        </div>
        
        <!-- Welcome Message -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 hover-card">
          <div class="card-body p-4">
            <div class="d-flex align-items-center">
              <div class="avatar-circle me-3">
                <i class="bi bi-person-circle text-gold"></i>
              </div>
              <div>
                <h5 class="fw-bold mb-1">Welcome back, <%= user.name %>!</h5>
                <p class="text-muted mb-0">Manage your property listings from your seller dashboard.</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Action Buttons -->
        <div class="row g-4 mb-5">
          <div class="col-12 animate__animated animate__fadeInUp animate__delay-1s">
            <div class="card border-0 shadow-sm rounded-3 hover-card">
              <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Quick Actions</h5>
                <div class="row g-3">
                  <div class="col-md-6">
                    <a href="/seller/add-property" class="btn btn-gold btn-lg w-100 py-3 hover-transform">
                      <i class="bi bi-plus-circle me-2"></i>Add New Property
                    </a>
                  </div>
                  <div class="col-md-6">
                    <a href="/seller/listed-properties" class="btn btn-outline-gold btn-lg w-100 py-3 hover-transform">
                      <i class="bi bi-houses me-2"></i>View My Properties
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Dashboard Stats -->
        <div class="row g-4 mb-4">
          <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-2s">
            <div class="card border-0 shadow-sm rounded-3 h-100 hover-card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="feature-icon me-3">
                    <i class="bi bi-house-check text-gold"></i>
                  </div>
                  <h5 class="card-title fw-bold mb-0">Listings</h5>
                </div>
                <p class="card-text text-muted">Manage all your property listings in one place.</p>
                <a href="/seller/listed-properties" class="btn btn-sm btn-outline-gold hover-transform">View Listings</a>
              </div>
            </div>
          </div>
          
          <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-3s">
            <div class="card border-0 shadow-sm rounded-3 h-100 hover-card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="feature-icon me-3">
                    <i class="bi bi-plus-circle text-gold"></i>
                  </div>
                  <h5 class="card-title fw-bold mb-0">Add Property</h5>
                </div>
                <p class="card-text text-muted">Submit a new property for verification and listing.</p>
                <a href="/seller/add-property" class="btn btn-sm btn-outline-gold hover-transform">Add New</a>
              </div>
            </div>
          </div>
          
          <div class="col-md-4 animate__animated animate__fadeInUp animate__delay-4s">
            <div class="card border-0 shadow-sm rounded-3 h-100 hover-card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="feature-icon me-3">
                    <i class="bi bi-person-vcard text-gold"></i>
                  </div>
                  <h5 class="card-title fw-bold mb-0">My Profile</h5>
                </div>
                <p class="card-text text-muted">Update your profile details and account settings.</p>
                <a href="/seller/profile" class="btn btn-sm btn-outline-gold hover-transform">Edit Profile</a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Property Status Summary -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 hover-card animate__animated animate__fadeInUp animate__delay-5s">
          <div class="card-body p-4">
            <h5 class="fw-bold mb-4">Property Listing Status</h5>
            <div class="alert bg-light border border-gold" role="alert">
              <i class="bi bi-info-circle-fill me-2 text-gold"></i>
              You can check the status of your property listings and manage them from the "My Properties" section.
            </div>
            <div class="text-center mt-3">
              <a href="/seller/listed-properties" class="btn btn-gold hover-transform">
                <i class="bi bi-houses me-2"></i>View My Properties
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-gold">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <%- include('../partials/footer-scripts') %>
</body>
</html>
