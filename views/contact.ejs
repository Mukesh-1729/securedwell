<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
</head>
<body class="bg-light">
  
  <%- include('partials/navbar') %>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <!-- Page Header -->
        <div class="text-center mb-5 animate__animated animate__fadeIn">
          <h1 class="display-5 fw-bold">Contact Us</h1>
          <p class="lead text-muted">Have questions? We're here to help you.</p>
        </div>

        <!-- Only Contact Info -->
        <div class="row g-5">
          <div class="col-md-12 animate__animated animate__fadeInUp">
            <div class="card border-0 shadow-sm rounded-3 h-100">
              <div class="card-body p-4 p-md-5">
                <h4 class="fw-bold mb-4"><i class="bi bi-info-circle me-2 text-primary"></i>Contact Information</h4>
                
                <div class="d-flex mb-4">
                  <div class="contact-icon me-3">
                    <i class="bi bi-envelope-fill text-primary"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold">Email</h6>
                    <p class="text-muted mb-0">support@securedwell.com</p>
                  </div>
                </div>
                
                <div class="d-flex mb-4">
                  <div class="contact-icon me-3">
                    <i class="bi bi-telephone-fill text-primary"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold">Phone</h6>
                    <p class="text-muted mb-0">+91-9701317670</p>
                  </div>
                </div>
                
                <div class="d-flex mb-4">
                  <div class="contact-icon me-3">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold">Address</h6>
                    <p class="text-muted mb-0"> DTCP Building, Ground Floor, 640, A.C.Guads, Masab Tank, 500004 , Hyderabad, Telangana ,India</p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  
  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-primary">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <style>
    .contact-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      font-size: 1.25rem;
      position: relative;
    }

    .contact-icon::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      background-color: rgba(212, 175, 55, 0.15);
      border-radius: var(--border-radius);
      transform: rotate(45deg);
      z-index: -1;
    }

    .hover-transform {
      transition: all 0.3s ease;
    }
    
    .hover-transform:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
  </style>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
