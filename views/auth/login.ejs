<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    .auth-card {
      border: none;
      border-radius: var(--border-radius-lg);
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }
    
    .auth-header-icon {
      background-color: rgba(var(--bs-warning-rgb), 0.1) !important;
    }
    
    /* Improved input icon styles */
    .input-with-icon {
      position: relative;
      display: block;
    }
    
    .input-with-icon .form-control {
      padding-left: 2.5rem !important;
    }
    
    .input-icon {
      position: absolute !important;
      left: 1rem !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      color: var(--gold-600) !important;
      z-index: 5 !important;
      font-size: 1.1rem !important;
    }
    
    .password-toggle {
      position: absolute !important;
      right: 1rem !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      cursor: pointer !important;
      color: var(--gray-500) !important;
      transition: all 0.3s ease !important;
      font-size: 1.1rem !important;
      z-index: 10 !important;
    }
    
    .password-toggle:hover {
      color: var(--primary) !important;
    }
    
    .login-btn {
      background-color: var(--primary);
      border-color: var(--primary);
      transition: all 0.3s ease;
    }
    
    .login-btn:hover {
      background-color: var(--primary-dark);
      border-color: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
    
    .register-link {
      color: var(--primary);
      font-weight: 500;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    
    .register-link:hover {
      color: var(--primary-dark);
      text-decoration: underline;
    }
    
    .error-message {
      color: var(--danger);
      font-size: 0.875rem;
      margin-top: 0.5rem;
      display: none;
    }
    
    .error-message.active {
      display: block;
    }
    
    .form-control.is-invalid {
      border-color: var(--danger);
      background-image: none;
    }
    
    .form-control.is-invalid:focus {
      box-shadow: 0 0 0 0.25rem rgba(var(--bs-danger-rgb), 0.25);
    }
    
    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 0.25rem rgba(var(--bs-warning-rgb), 0.25);
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">

  <%- include('../partials/navbar') %>

  <div class="container login-container flex-grow-1 d-flex align-items-center">
    <div class="row justify-content-center w-100">
      <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="auth-card card animate__animated animate__fadeIn">
          <div class="card-body p-4 p-lg-5">
            <div class="text-center mb-4">
              <div class="auth-header-icon rounded-circle p-3 d-inline-block mb-3">
                <i class="bi bi-shield-lock fs-1 text-primary"></i>
              </div>
              <h2 class="fw-bold mb-2">Welcome Back</h2>
              <p class="text-muted">Sign in to your SecureDwell account</p>
            </div>
   
            <form id="loginForm" action="/login" method="POST" novalidate>
              <!-- Email Field -->
              <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <div class="input-with-icon">
                  <i class="bi bi-envelope input-icon"></i>
                  <input type="email" class="form-control <%= (typeof errors !== 'undefined' && errors && errors.email) ? 'is-invalid' : '' %>" id="email" name="email" placeholder="Enter your email address" value="<%= typeof email !== 'undefined' ? email : '' %>" required>
                </div>
                <div id="emailError" class="error-message <%= (typeof errors !== 'undefined' && errors && errors.email) ? 'active' : '' %>">
                  <%= (typeof errors !== 'undefined' && errors && errors.email) ? errors.email : 'Please enter a valid email address.' %>
                </div>
              </div>
              
              <!-- Password Field -->
              <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <div class="input-with-icon">
                  <i class="bi bi-lock input-icon"></i>
                  <input type="password" class="form-control <%= (typeof errors !== 'undefined' && errors && errors.password) ? 'is-invalid' : '' %>" id="password" name="password" placeholder="Enter your password" required>
                  <i class="bi bi-eye-slash password-toggle" id="passwordToggle"></i>
                </div>
                <div id="passwordError" class="error-message <%= (typeof errors !== 'undefined' && errors && errors.password) ? 'active' : '' %>">
                  <%= (typeof errors !== 'undefined' && errors && errors.password) ? errors.password : 'Password must be at least 8 characters.' %>
                </div>
              </div>
              
              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger mb-3" role="alert">
                  <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                </div>
              <% } %>
              
              <!-- Submit Button -->
              <div class="d-grid mb-4">
                <button type="submit" class="btn btn-primary py-2 login-btn">
                  <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
              </div>
              
              <!-- Register Link -->
              <div class="text-center">
                <p class="mb-0">Don't have an account? <a href="/register" class="register-link">Register here</a></p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="py-4 mt-auto">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Show/hide password functionality
    document.getElementById('passwordToggle').addEventListener('click', function() {
      const passwordInput = document.getElementById('password');
      const icon = this;
      
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
      } else {
        passwordInput.type = 'password';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
      }
    });
    
    // Client-side validation
    document.getElementById('loginForm').addEventListener('submit', function(event) {
      let isValid = true;
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const emailError = document.getElementById('emailError');
      const passwordError = document.getElementById('passwordError');
      
      // Reset errors
      emailError.classList.remove('active');
      passwordError.classList.remove('active');
      emailInput.classList.remove('is-invalid');
      passwordInput.classList.remove('is-invalid');
      
      // Validate email
      if (!emailInput.value || !emailInput.value.includes('@') || !emailInput.value.includes('.')) {
        emailInput.classList.add('is-invalid');
        emailError.classList.add('active');
        isValid = false;
      }
      
      // Validate password
      if (!passwordInput.value || passwordInput.value.length < 8) {
        passwordInput.classList.add('is-invalid');
        passwordError.classList.add('active');
        isValid = false;
      }
      
      if (!isValid) {
        event.preventDefault();
      }
    });
    
    // Add entrance animations
    document.addEventListener('DOMContentLoaded', function() {
      // Ensure icons are visible
      const icons = document.querySelectorAll('.input-icon, .password-toggle');
      icons.forEach(icon => {
        icon.style.opacity = '1';
        icon.style.visibility = 'visible';
        icon.style.display = 'block';
      });
      
      const formFields = document.querySelectorAll('.form-control');
      formFields.forEach((field, index) => {
        field.style.opacity = '0';
        field.style.transform = 'translateY(20px)';
        field.style.transition = 'all 0.3s ease';
        
        setTimeout(() => {
          field.style.opacity = '1';
          field.style.transform = 'translateY(0)';
        }, 100 + (index * 100));
      });
    });
  </script>
</body>
</html>
