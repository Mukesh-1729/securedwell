<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Property Listings - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    :root {
      --bs-primary-rgb: 212, 175, 55;
      --bs-primary-light: rgba(var(--bs-primary-rgb), 0.1);
    }
    
    body {
      background-color: #f8f9fa;
    }
    
    .hero-section {
      background: linear-gradient(to right, var(--primary), var(--primary-dark));
      padding: 4rem 0;
      border-radius: 0 0 1rem 1rem;
      margin-bottom: 2rem;
    }
    
    .hero-section h1 {
      color: white;
      margin-bottom: 1rem;
    }
    
    .hero-section p {
      color: rgba(255, 255, 255, 0.8);
    }
    
    .search-card {
      border: none;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      margin-top: -2rem;
      z-index: 2;
      position: relative;
      border-radius: 1rem;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    
    .search-card:hover {
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }
    
    .property-card {
      transition: all 0.3s ease;
      border: none;
      overflow: hidden;
    }
    
    .property-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1) !important;
    }
    
    .property-card .card-img-wrapper {
      position: relative;
      overflow: hidden;
      height: 200px;
    }
    
    .property-card .card-img-wrapper img {
      transition: transform 0.5s ease;
      height: 100%;
      width: 100%;
      object-fit: cover;
    }
    
    .property-card:hover .card-img-wrapper img {
      transform: scale(1.1);
    }
    
    .property-card .price-badge {
      position: absolute;
      top: 15px;
      right: 15px;
      z-index: 10;
      transition: all 0.3s ease;
    }
    
    .property-card:hover .price-badge {
      transform: translateX(-5px);
    }
    
    .property-card .card-body {
      padding: 1.5rem;
    }
    
    .property-features {
      display: flex;
      justify-content: space-between;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      padding-top: 1rem;
      margin-top: 1rem;
    }
    
    .property-feature {
      display: flex;
      align-items: center;
      color: #6c757d;
      font-size: 0.9rem;
    }
    
    .property-feature i {
      margin-right: 5px;
      color: var(--primary);
    }
    
    .filter-controls {
      margin-bottom: 2rem;
      overflow: hidden;
      height: 0;
      opacity: 0;
      transition: all 0.5s ease;
    }
    
    .filter-controls.show {
      height: auto;
      opacity: 1;
      padding: 1.5rem;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      margin-top: 1.5rem;
    }
    
    .filter-toggle {
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .filter-toggle:hover {
      color: var(--primary);
    }
    
    .filter-toggle i {
      transition: transform 0.3s ease;
    }
    
    .filter-toggle.active i {
      transform: rotate(-180deg);
    }
    
    .filter-wrapper {
      margin-bottom: 1.5rem;
    }
    
    .filter-label {
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: #495057;
    }
    
    .noUi-connect {
      background: var(--primary);
    }
    
    .noUi-horizontal {
      height: 8px;
    }
    
    .noUi-handle {
      border: 1px solid var(--primary);
      background: white;
      box-shadow: 0 3px 8px rgba(var(--bs-primary-rgb), 0.3);
    }
    
    .noUi-handle:before,
    .noUi-handle:after {
      background: var(--primary);
    }
    
    .range-values {
      display: flex;
      justify-content: space-between;
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: #6c757d;
    }
    
    .no-results {
      background-color: white;
      border-radius: 1rem;
      padding: 3rem;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }
    
    .no-results i {
      font-size: 4rem;
      color: var(--primary);
      opacity: 0.5;
      margin-bottom: 1.5rem;
    }
    
    .btn-filter {
      border-radius: 0.5rem;
      padding: 0.6rem 1.2rem;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    
    .btn-filter:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(var(--bs-primary-rgb), 0.2);
    }
    
    .input-with-icon {
      position: relative;
    }
    
    .input-with-icon .form-control {
      padding-left: 2.5rem;
      border-radius: 0.5rem;
      height: 3rem;
    }
    
    .input-with-icon i {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #6c757d;
    }
    
    .form-select {
      height: 3rem;
      border-radius: 0.5rem;
    }
    
    .form-control:focus,
    .form-select:focus {
      box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
      border-color: var(--primary);
    }
  </style>
</head>
<body class="bg-light">
  
  <%- include('../partials/navbar') %>
  
  <!-- Hero Section -->
  <div class="hero-section animate__animated animate__fadeIn">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
          <h1 class="display-5 fw-bold">Find Your Perfect Property</h1>
          <p class="lead mb-0">Browse through our verified listings across Telangana</p>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container animate__animated animate__fadeInUp">
    <!-- 🔍 Search Filter Card -->
    <div class="card search-card mb-5">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="card-title mb-0">
            <i class="bi bi-search me-2 text-primary"></i>Search Properties
          </h5>
          <div class="filter-toggle" id="filterToggle">
            <span class="d-flex align-items-center text-muted">
              Advanced Filters <i class="bi bi-chevron-down ms-2"></i>
            </span>
          </div>
        </div>
        
        <form action="/property/listings" method="GET" class="row g-3">
          <!-- Basic Search Fields -->
          <div class="col-md-9">
            <div class="input-with-icon">
              <i class="bi bi-geo-alt"></i>
              <input type="text" name="location" class="form-control" placeholder="Location (e.g. Hyderabad)">
            </div>
          </div>
          
          <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary py-2 btn-filter">
              <i class="bi bi-search me-2"></i>Search
            </button>
          </div>
          
          <!-- Advanced Filter Controls (Hidden by Default) -->
          <div class="col-12 filter-controls" id="filterControls">
            <div class="row">
              <div class="col-md-3">
                <div class="filter-wrapper">
                  <label class="filter-label">Min Price</label>
                  <div class="input-with-icon">
                    <i class="bi bi-currency-rupee"></i>
                    <input type="number" name="minPrice" class="form-control" placeholder="500000">
                  </div>
                </div>
              </div>
              
              <div class="col-md-3">
                <div class="filter-wrapper">
                  <label class="filter-label">Max Price</label>
                  <div class="input-with-icon">
                    <i class="bi bi-currency-rupee"></i>
                    <input type="number" name="maxPrice" class="form-control" placeholder="Max Price (₹)">
                  </div>
                </div>
              </div>
              
              <div class="col-md-3">
                <div class="filter-wrapper">
                  <label class="filter-label">Bedrooms</label>
                  <select class="form-select" name="bedrooms">
                    <option value="">Any</option>
                    <option value="1">1 Bedroom</option>
                    <option value="2">2 Bedrooms</option>
                    <option value="3">3 Bedrooms</option>
                    <option value="4">4+ Bedrooms</option>
                  </select>
                </div>
              </div>
              
              <div class="col-md-3">
                <div class="filter-wrapper">
                  <label class="filter-label">Bathrooms</label>
                  <select class="form-select" name="bathrooms">
                    <option value="">Any</option>
                    <option value="1">1 Bathroom</option>
                    <option value="2">2 Bathrooms</option>
                    <option value="3">3+ Bathrooms</option>
                  </select>
                </div>
              </div>
            </div>
            
            <div class="row mt-3">
              <div class="col-md-6">
                <div class="filter-wrapper">
                  <label class="filter-label">Area (sq ft)</label>
                  <div class="row g-2">
                    <div class="col-6">
                      <input type="number" name="minSquareFeet" class="form-control" placeholder="Min">
                    </div>
                    <div class="col-6">
                      <input type="number" name="maxSquareFeet" class="form-control" placeholder="Max">
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="d-flex justify-content-end align-items-end h-100">
                  <button type="reset" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-repeat me-2"></i>Reset
                  </button>
                  <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-filter me-2"></i>Apply Filters
                  </button>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- 🏘 Property Cards -->
    <div class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
          <i class="bi bi-houses me-2 text-primary"></i>Available Properties
        </h3>
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-sort me-2"></i>Sort By
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sortDropdown">
            <li><a class="dropdown-item" href="?sort=newest">Newest First</a></li>
            <li><a class="dropdown-item" href="?sort=priceAsc">Price: Low to High</a></li>
            <li><a class="dropdown-item" href="?sort=priceDesc">Price: High to Low</a></li>
          </ul>
        </div>
      </div>
      
      <% if (properties.length > 0) { %>
        <div class="row g-4 properties-container">
          <% properties.forEach((property, index) => { %>
            <div class="col-md-6 col-lg-4 property-item" data-delay="<%= index * 100 %>">
              <div class="card property-card h-100 shadow-sm">
                <div class="card-img-wrapper">
                  <% if (property.images && property.images.length > 0) { %>
                    <img src="<%= property.images[0] %>" class="card-img-top" alt="<%= property.title %>">
                  <% } else { %>
                    <img src="https://via.placeholder.com/600x400.png?text=No+Image" class="card-img-top" alt="<%= property.title %>">
                  <% } %>
                  <div class="price-badge">
                    <span class="badge bg-primary rounded-pill px-3 py-2 shadow-sm">₹<%= property.price.toLocaleString() %></span>
                  </div>
                </div>
                
                <div class="card-body">
                  <h5 class="card-title fw-bold mb-2 text-truncate"><%= property.title %></h5>
                  
                  <p class="card-text mb-3 text-muted">
                    <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                    <%= property.location %>
                  </p>
                  
                  <div class="property-features">
                    <div class="property-feature">
                      <i class="bi bi-building"></i>
                      <span><%= property.bedrooms %> Beds</span>
                    </div>
                    <div class="property-feature">
                      <i class="bi bi-water"></i>
                      <span><%= property.bathrooms %> Baths</span>
                    </div>
                    <div class="property-feature">
                      <i class="bi bi-rulers"></i>
                      <span><%= property.squareFeet %> sqft</span>
                    </div>
                  </div>
                  
                  <div class="d-grid mt-3">
                    <% if (locals.user) { %>
                      <a href="/property/<%= property._id %>" class="btn btn-outline-primary">
                        <i class="bi bi-info-circle me-2"></i>View Details
                      </a>
                    <% } else { %>
                      <a href="/login" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login to View
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-results animate__animated animate__fadeIn">
          <i class="bi bi-search"></i>
          <h4 class="fw-bold mb-3">No properties found</h4>
          <p class="text-muted mb-4">We couldn't find any properties matching your search criteria. Try adjusting your filters.</p>
          <a href="/property/listings" class="btn btn-primary px-4 py-2">
            <i class="bi bi-arrow-repeat me-2"></i>Reset Filters
          </a>
        </div>
      <% } %>
      
      <!-- Pagination (can be enhanced with actual pagination) -->
      <% if (properties.length > 0) { %>
        <div class="d-flex justify-content-center mt-5">
          <nav aria-label="Page navigation">
            <ul class="pagination">
              <li class="page-item disabled">
                <a class="page-link" href="#" aria-label="Previous">
                  <span aria-hidden="true">&laquo;</span>
                </a>
              </li>
              <li class="page-item active"><a class="page-link" href="#">1</a></li>
              <li class="page-item"><a class="page-link" href="#">2</a></li>
              <li class="page-item"><a class="page-link" href="#">3</a></li>
              <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                  <span aria-hidden="true">&raquo;</span>
                </a>
              </li>
            </ul>
          </nav>
        </div>
      <% } %>
    </div>
  </div>
  
  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.js"></script>
  
  <script>
    // Toggle advanced filters
    document.addEventListener('DOMContentLoaded', function() {
      const filterToggle = document.getElementById('filterToggle');
      const filterControls = document.getElementById('filterControls');
      
      filterToggle.addEventListener('click', function() {
        filterControls.classList.toggle('show');
        filterToggle.classList.toggle('active');
      });
      
      // Check URL parameters to see if advanced filters should be shown
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('minPrice') || urlParams.has('bedrooms') || urlParams.has('bathrooms') || 
          urlParams.has('minSquareFeet') || urlParams.has('maxSquareFeet')) {
        filterControls.classList.add('show');
        filterToggle.classList.add('active');
      }
      
      // Set form values from URL parameters
      for (const [key, value] of urlParams.entries()) {
        const input = document.querySelector(`[name="${key}"]`);
        if (input) {
          input.value = value;
        }
      }
      
      // Animate property items with staggered delay
      const propertyItems = document.querySelectorAll('.property-item');
      propertyItems.forEach((item, index) => {
        setTimeout(() => {
          item.classList.add('animate__animated', 'animate__fadeInUp');
        }, index * 100);
      });
    });
  </script>
</body>
</html>
