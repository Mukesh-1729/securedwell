<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - SecureDwell</title>
  
  <!-- Bootstrap & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  
  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/modern-theme.css">
  
  <!-- Additional styles -->
  <% if (typeof styles !== 'undefined') { %>
    <%- styles %>
  <% } %>
</head>
<body class="d-flex flex-column min-vh-100">
  
  <%- include('../partials/navbar') %>
  
  <main class="flex-grow-1">
    <%- body %>
  </main>
  
  <footer class="py-4 mt-auto">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>
  
  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Animation initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Add fade-in animation to cards
      document.querySelectorAll('.card').forEach(card => {
        card.classList.add('fade-in');
      });
      
      // Add slide-up animation to sections
      document.querySelectorAll('section').forEach(section => {
        section.classList.add('slide-up');
      });
    });
  </script>
  
  <!-- Additional scripts -->
  <% if (typeof scripts !== 'undefined') { %>
    <%- scripts %>
  <% } %>
</body>
</html> 