<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    :root {
      --primary-color: #D4AF37;
      --primary-dark: #B8860B;
      --primary-light: #F5DEB3;
      --accent-color: #8B4513;
    }
    .sidebar {
      background: linear-gradient(135deg, #1a1a1a, #333);
      min-height: 100vh;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
      z-index: 1000;
    }
    .sidebar .nav-link {
      color: #e0e0e0;
      border-radius: 5px;
      margin: 5px 0;
      transition: all 0.3s;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background-color: var(--primary-color);
      color: #1a1a1a;
      transform: translateX(5px);
    }
    .sidebar .nav-link i {
      width: 24px;
    }
    .profile-card {
      transition: all 0.3s ease;
      border: none;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .profile-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .btn-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
      border: none;
    }
    .btn-gold:hover {
      background-color: var(--primary-dark);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }
    .btn-outline-gold {
      color: var(--primary-color);
      border-color: var(--primary-color);
    }
    .btn-outline-gold:hover {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .badge-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .profile-header {
      background-color: white;
      border-radius: 10px;
      overflow: hidden;
    }
    .profile-banner {
      height: 120px;
      background: linear-gradient(90deg, var(--primary-dark), var(--primary-color));
    }
    .profile-avatar {
      width: 100px;
      height: 100px;
      background-color: white;
      border: 4px solid white;
      border-radius: 50%;
      margin-top: -50px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }
    .timeline {
      position: relative;
      margin-left: 1.5rem;
    }
    .timeline::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: -10px;
      width: 2px;
      background-color: var(--primary-light);
    }
    .timeline-item {
      position: relative;
      padding-bottom: 1.5rem;
    }
    .timeline-item::before {
      content: "";
      position: absolute;
      left: -18px;
      top: 0;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background-color: var(--primary-color);
      border: 3px solid white;
    }
    .text-gold {
      color: var(--primary-color) !important;
    }
    .bg-gold {
      background-color: var(--primary-color) !important;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-2 col-md-3 p-0 sidebar">
        <div class="d-flex flex-column p-3 sticky-top">
          <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
            <span class="fs-4 fw-bold text-white">SecureDwell</span>
          </a>
          <hr class="text-white-50">
          <div class="d-flex align-items-center mb-4">
            <div class="rounded-circle bg-white p-2 me-2">
              <i class="bi bi-person-fill fs-5 text-dark"></i>
            </div>
            <div>
              <p class="m-0 text-white"><%= buyer.name %></p>
              <small class="text-white-50">Buyer</small>
            </div>
          </div>
          <ul class="nav nav-pills flex-column mb-auto animate__animated animate__fadeInLeft">
            <li class="nav-item">
              <a href="/buyer/dashboard" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/profile" class="nav-link active">
                <i class="bi bi-person me-2"></i>
                My Profile
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/favourites" class="nav-link">
                <i class="bi bi-heart-fill me-2"></i>
                My Favourites
              </a>
            </li>
            <li class="nav-item">
              <a href="/property/listings" class="nav-link">
                <i class="bi bi-building me-2"></i>
                Property Listings
              </a>
            </li>
            <li class="nav-item mt-5">
              <a href="/logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i>
                Logout
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-10 col-md-9 p-0 bg-light">
        <div class="container py-4">
          <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
            <h2 class="fw-bold"><i class="bi bi-person-fill me-2 text-gold"></i> My Profile</h2>
            <span class="badge badge-gold rounded-pill px-3 py-2">Buyer Account</span>
          </div>

          <!-- Profile Header -->
          <div class="profile-header shadow-sm mb-4 animate__animated animate__fadeIn">
            <div class="profile-banner"></div>
            <div class="px-4 pb-4">
              <div class="d-md-flex align-items-end">
                <div class="profile-avatar bg-white shadow text-gold">
                  <i class="bi bi-person-fill"></i>
                </div>
                <div class="ms-md-4 mt-3 mt-md-0">
                  <h3 class="fw-bold mb-1"><%= buyer.name %></h3>
                  <p class="text-muted mb-0"><i class="bi bi-envelope text-gold me-2"></i><%= buyer.email %></p>
                </div>
                
              </div>
            </div>
          </div>

          <div class="row">
            <!-- Personal Information -->
            <div class="col-lg-7 mb-4 animate__animated animate__fadeInUp">
              <div class="card border-0 shadow-sm profile-card">
                <div class="card-header bg-white py-3 border-0">
                  <h5 class="fw-bold mb-0"><i class="bi bi-person-lines-fill me-2 text-gold"></i> Personal Information</h5>
                </div>
                <div class="card-body p-4">
                  <div class="row mb-3">
                    <div class="col-md-4 text-muted">Full Name</div>
                    <div class="col-md-8 fw-medium"><%= buyer.name %></div>
                  </div>
                  <div class="row mb-3">
                    <div class="col-md-4 text-muted">Email Address</div>
                    <div class="col-md-8 fw-medium"><%= buyer.email %></div>
                  </div>
                  <div class="row mb-3">
                    <div class="col-md-4 text-muted">Phone Number</div>
                    <div class="col-md-8 fw-medium"><%= buyer.phone || 'Not provided' %></div>
                  </div>
                  <div class="row mb-3">
                    <div class="col-md-4 text-muted">Role</div>
                    <div class="col-md-8 fw-medium"><%= buyer.role.charAt(0).toUpperCase() + buyer.role.slice(1) %></div>
                  </div>
                  <div class="row mb-0">
                    <div class="col-md-4 text-muted">Member Since</div>
                    <div class="col-md-8 fw-medium"><%= new Date(buyer.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Account Status -->
            <div class="col-lg-5 mb-4 animate__animated animate__fadeInUp animate__delay-1s">
              <div class="card border-0 shadow-sm profile-card">
                <div class="card-header bg-white py-3 border-0">
                  <h5 class="fw-bold mb-0"><i class="bi bi-shield-check me-2 text-gold"></i> Account Status</h5>
                </div>
                <div class="card-body p-4">
                  <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                      <i class="bi bi-check-circle-fill text-success fs-4"></i>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-1">Verified Account</h6>
                      <p class="mb-0 text-muted">Your account has been verified</p>
                    </div>
                  </div>
                  
                  
                </div>
              </div>
              
              <div class="d-grid gap-2 mt-3">
                
                
              </div>
            </div>
          </div>

          <!-- Actions and Notifications -->
          <div class="card border-0 shadow-sm profile-card mb-4 animate__animated animate__fadeInUp animate__delay-2s">
            <div class="card-header bg-white py-3 border-0">
              <h5 class="fw-bold mb-0"><i class="bi bi-bell me-2 text-gold"></i> Recent Activities</h5>
            </div>
            <div class="card-body p-4">
              <div class="text-center py-4">
                <i class="bi bi-activity display-4 text-gold opacity-50 mb-3"></i>
                <h5 class="fw-bold">No Recent Activity</h5>
                <p class="text-muted">Start browsing properties to see your activity here.</p>
                <a href="/property/listings" class="btn btn-gold mt-2 animate__animated animate__pulse animate__infinite animate__slower">
                  <i class="bi bi-search me-2"></i>Browse Properties
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-gold">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
