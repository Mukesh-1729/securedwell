<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Favourites - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    :root {
      --primary-color: #D4AF37;
      --primary-dark: #B8860B;
      --primary-light: #F5DEB3;
      --accent-color: #8B4513;
    }
    .sidebar {
      background: linear-gradient(135deg, #1a1a1a, #333);
      min-height: 100vh;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
      z-index: 1000;
    }
    .sidebar .nav-link {
      color: #e0e0e0;
      border-radius: 5px;
      margin: 5px 0;
      transition: all 0.1s;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background-color: var(--primary-color);
      color: #1a1a1a;
      transform: translateX(5px);
    }
    .sidebar .nav-link i {
      width: 24px;
    }
    .property-card {
      transition: all 0.1s ease;
      border: none;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .property-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .property-card img {
      height: 200px;
      object-fit: cover;
      transition: all 0.5s;
    }
    .property-card:hover img {
      transform: scale(1.05);
    }
    .btn-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
      border: none;
    }
    .btn-gold:hover {
      background-color: var(--primary-dark);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }
    .btn-outline-gold {
      color: var(--primary-color);
      border-color: var(--primary-color);
    }
    .btn-outline-gold:hover {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .property-feature {
      background-color: rgba(212, 175, 55, 0.1);
      color: var(--primary-dark);
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      margin-right: 10px;
    }
    .badge-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .empty-state-icon {
      color: var(--primary-light);
      animation: pulse 2s infinite;
    }
    .text-gold {
      color: var(--primary-color) !important;
    }
    .bg-gold {
      background-color: var(--primary-color) !important;
    }
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.05); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-2 col-md-3 p-0 sidebar">
        <div class="d-flex flex-column p-3 sticky-top">
          <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
            <span class="fs-4 fw-bold text-white">SecureDwell</span>
          </a>
          <hr class="text-white-50">
          <div class="d-flex align-items-center mb-4">
            <div class="rounded-circle bg-white p-2 me-2">
              <i class="bi bi-person-fill fs-5 text-dark"></i>
            </div>
            <div>
              <p class="m-0 text-white"><%= user.name %></p>
              <small class="text-white-50">Buyer</small>
            </div>
          </div>
          <ul class="nav nav-pills flex-column mb-auto animate__animated animate__fadeInLeft">
            <li class="nav-item">
              <a href="/buyer/dashboard" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/profile" class="nav-link">
                <i class="bi bi-person me-2"></i>
                My Profile
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/favourites" class="nav-link active">
                <i class="bi bi-heart-fill me-2"></i>
                My Favourites
              </a>
            </li>
            <li class="nav-item">
              <a href="/property/listings" class="nav-link">
                <i class="bi bi-building me-2"></i>
                Property Listings
              </a>
            </li>
            <li class="nav-item mt-5">
              <a href="/logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i>
                Logout
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-10 col-md-9 p-0 bg-light">
        <div class="container py-4">
          <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
            <h2 class="fw-bold"><i class="bi bi-heart-fill me-2 text-gold"></i> My Favourite Properties</h2>
            <a href="/property/listings" class="btn btn-gold">
              <i class="bi bi-search me-2"></i>Browse Properties
            </a>
          </div>

          <div class="card border-0 shadow-sm animate__animated animate__fadeIn">
            <div class="card-body p-4">
              <% if (favourites && favourites.length > 0) { %>
                <div class="row">
                  <% favourites.forEach(property => { %>
                    <div class="col-lg-4 col-md-6 mb-4 animate__animated animate__fadeInUp">
                      <div class="property-card card h-100">
                        <div class="position-relative">
                          <img src="<%= property.images[0] || '/img/property-placeholder.jpg' %>" class="card-img-top" alt="<%= property.title %>">
                          <span class="badge badge-gold position-absolute top-0 end-0 m-2"><%= property.propertyType %></span>
                        </div>
                        <div class="card-body">
                          <h5 class="card-title fw-bold mb-1"><%= property.title %></h5>
                          <p class="text-muted mb-2">
                            <i class="bi bi-geo-alt-fill me-1 text-gold"></i> <%= property.location %>
                          </p>
                          <p class="fw-bold text-gold mb-3">₹<%= property.price.toLocaleString() %></p>
                          <div class="d-flex mb-3">
                            <div class="property-feature">
                              <i class="bi bi-door-open me-1"></i> <%= property.bedrooms %> Beds
                            </div>
                            <div class="property-feature">
                              <i class="bi bi-droplet me-1"></i> <%= property.bathrooms %> Baths
                            </div>
                            <div class="property-feature">
                              <i class="bi bi-rulers me-1"></i> <%= property.area %> sq ft
                            </div>
                          </div>
                          <div class="d-flex mt-auto">
                            <a href="/property/<%= property._id %>" class="btn btn-gold flex-grow-1 me-2">
                              <i class="bi bi-info-circle me-1"></i> View Details
                            </a>
                            <form action="/buyer/favourites/<%= property._id %>/remove" method="POST">
                              <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-heart-fill"></i>
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="text-center py-5 animate__animated animate__fadeIn">
                  <i class="bi bi-heart display-1 empty-state-icon mb-3"></i>
                  <h4 class="fw-bold mb-3">No Favourite Properties</h4>
                  <p class="text-muted mb-4">You haven't saved any properties to your favourites yet.</p>
                  <a href="/property/listings" class="btn btn-gold px-4 py-2 animate__animated animate__pulse animate__infinite animate__slower">
                    <i class="bi bi-search me-2"></i>Browse Properties
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-gold">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 