<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buyer Dashboard - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
  <link rel="stylesheet" href="/css/modern-theme.css">
  <style>
    :root {
      --primary-color: #D4AF37;
      --primary-dark: #B8860B;
      --primary-light: #F5DEB3;
      --accent-color: #8B4513;
    }
    .sidebar {
      background: linear-gradient(135deg, #1a1a1a, #333);
      min-height: 100vh;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
      z-index: 1000;
    }
    .sidebar .nav-link {
      color: #e0e0e0;
      border-radius: 5px;
      margin: 5px 0;
      transition: all 0.1s;
    }
    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background-color: var(--primary-color);
      color: #1a1a1a;
      transform: translateX(5px);
    }
    .sidebar .nav-link i {
      width: 24px;
    }
    .dashboard-card {
      transition: all 0.1s ease;
      border: none;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .dashboard-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .btn-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
      border: none;
    }
    .btn-gold:hover {
      background-color: var(--primary-dark);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }
    .btn-outline-gold {
      color: var(--primary-color);
      border-color: var(--primary-color);
    }
    .btn-outline-gold:hover {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .badge-gold {
      background-color: var(--primary-color);
      color: #1a1a1a;
    }
    .feature-icon {
      width: 50px;
      height: 50px;
      background-color: rgba(212, 175, 55, 0.1);
      color: var(--primary-color);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    .property-card {
      transition: all 0.1s ease;
      border: none;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .property-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .property-card img {
      height: 160px;
      object-fit: cover;
      transition: all 0.1s;
    }
    .property-card:hover img {
      transform: scale(1.05);
    }
    .text-gold {
      color: var(--primary-color) !important;
    }
    .bg-gold {
      background-color: var(--primary-color) !important;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-2 col-md-3 p-0 sidebar">
        <div class="d-flex flex-column p-3 sticky-top">
          <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
            <span class="fs-4 fw-bold text-white">SecureDwell</span>
          </a>
          <hr class="text-white-50">
          <div class="d-flex align-items-center mb-4">
            <div class="rounded-circle bg-white p-2 me-2">
              <i class="bi bi-person-fill fs-5 text-dark"></i>
            </div>
            <div>
              <p class="m-0 text-white"><%= user.name %></p>
              <small class="text-white-50">Buyer</small>
            </div>
          </div>
          <ul class="nav nav-pills flex-column mb-auto animate__animated animate__fadeInLeft">
            <li class="nav-item">
              <a href="/buyer/dashboard" class="nav-link active">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/profile" class="nav-link">
                <i class="bi bi-person me-2"></i>
                My Profile
              </a>
            </li>
            <li class="nav-item">
              <a href="/buyer/favourites" class="nav-link">
                <i class="bi bi-heart-fill me-2"></i>
                My Favourites
              </a>
            </li>
            <li class="nav-item">
              <a href="/property/listings" class="nav-link">
                <i class="bi bi-building me-2"></i>
                Property Listings
              </a>
            </li>
            <li class="nav-item mt-5">
              <a href="/logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i>
                Logout
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Main Content -->
      <div class="col-lg-10 col-md-9 p-0 bg-light">
        <div class="container py-4">
          <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
            <h2 class="fw-bold"><i class="bi bi-speedometer2 me-2 text-gold"></i> Buyer Dashboard</h2>
            <span class="badge badge-gold rounded-pill px-3 py-2">Buyer Account</span>
          </div>

          <!-- Welcome Card -->
          <div class="card border-0 shadow-sm mb-4 dashboard-card animate__animated animate__fadeIn">
            <div class="card-body p-4">
              <div class="d-flex align-items-center">
                <div class="rounded-circle bg-gold p-3 me-3 text-white">
                  <i class="bi bi-person-fill fs-4"></i>
                </div>
                <div>
                  <h4 class="fw-bold mb-1">Welcome back, <%= user.name %>!</h4>
                  <p class="text-muted mb-0">Here's what's happening with your account today.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="row mb-4">
            <div class="col-12 animate__animated animate__fadeInUp animate__delay-1s">
              <div class="card border-0 shadow-sm dashboard-card">
                <div class="card-body p-4">
                  <h5 class="fw-bold mb-3">Quick Actions</h5>
                  <div class="row">
                    <div class="col-md-6 col-lg-3 mb-3">
                      <a href="/property/listings" class="btn btn-gold w-100 py-3">
                        <i class="bi bi-search me-2"></i>Find Properties
                      </a>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                      <a href="/buyer/favourites" class="btn btn-outline-gold w-100 py-3">
                        <i class="bi bi-heart-fill me-2"></i>My Favourites
                      </a>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                      <a href="/buyer/profile" class="btn btn-outline-gold w-100 py-3">
                        <i class="bi bi-person me-2"></i>My Profile
                      </a>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-3">
                      <a href="/buyer/messages" class="btn btn-outline-gold w-100 py-3">
                        <i class="bi bi-chat-dots me-2"></i>Messages
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature Cards -->
          <div class="row mb-4">
            <div class="col-md-4 mb-4 animate__animated animate__fadeInUp animate__delay-2s">
              <div class="card border-0 shadow-sm h-100 dashboard-card">
                <div class="card-body p-4 text-center">
                  <div class="feature-icon mx-auto">
                    <i class="bi bi-house-door"></i>
                  </div>
                  <h5 class="fw-bold mb-2">Find Properties</h5>
                  <p class="text-muted mb-3">Search for verified properties across Telangana.</p>
                  <a href="/property/listings" class="btn btn-sm btn-outline-gold">Browse Listings</a>
                </div>
              </div>
            </div>
            <div class="col-md-4 mb-4 animate__animated animate__fadeInUp animate__delay-3s">
              <div class="card border-0 shadow-sm h-100 dashboard-card">
                <div class="card-body p-4 text-center">
                  <div class="feature-icon mx-auto">
                    <i class="bi bi-heart"></i>
                  </div>
                  <h5 class="fw-bold mb-2">Save Favorites</h5>
                  <p class="text-muted mb-3">Bookmark properties you're interested in for later.</p>
                  <a href="/buyer/favourites" class="btn btn-sm btn-outline-gold">View Favorites</a>
                </div>
              </div>
            </div>
            <div class="col-md-4 mb-4 animate__animated animate__fadeInUp animate__delay-4s">
              <div class="card border-0 shadow-sm h-100 dashboard-card">
                <div class="card-body p-4 text-center">
                  <div class="feature-icon mx-auto">
                    <i class="bi bi-chat-dots"></i>
                  </div>
                  <h5 class="fw-bold mb-2">Contact Sellers</h5>
                  <p class="text-muted mb-3">Reach out to property owners for more information.</p>
                  <a href="/buyer/messages" class="btn btn-sm btn-outline-gold">Check Messages</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Properties -->
          <div class="card border-0 shadow-sm mb-4 dashboard-card animate__animated animate__fadeInUp animate__delay-5s">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-4"><i class="bi bi-buildings me-2 text-gold"></i>Recently Added Properties</h5>
              <% if (latestProperties && latestProperties.length > 0) { %>
                <div class="row g-4">
                  <% latestProperties.forEach(property => { %>
                    <div class="col-md-6 col-lg-3">
                      <div class="card h-100 border-0 shadow-sm rounded-3 property-card">
                        <img src="<%= property.images[0] || 'https://via.placeholder.com/300x200?text=No+Image' %>" 
                             class="card-img-top" alt="<%= property.title %>">
                        <div class="card-body">
                          <h6 class="card-title fw-bold mb-1 text-truncate"><%= property.title %></h6>
                          <p class="card-text small text-muted mb-2">
                            <i class="bi bi-geo-alt-fill text-gold me-1"></i><%= property.location %>
                          </p>
                          <p class="card-text fw-semibold text-gold">₹<%= property.price.toLocaleString() %></p>
                          <div class="d-grid">
                            <a href="/property/<%= property._id %>" class="btn btn-sm btn-outline-gold">View Details</a>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="alert alert-light border border-warning" role="alert">
                  <i class="bi bi-info-circle-fill me-2 text-gold"></i>
                  Check out our recently added verified properties in your area.
                </div>
              <% } %>
              <div class="text-center mt-3">
                <a href="/property/listings" class="btn btn-gold">
                  <i class="bi bi-search me-2"></i>Browse All Properties
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="py-4 bg-dark text-white mt-5">
    <div class="container">
      <div class="row">
        <div class="col-md-6 text-center text-md-start">
          <h5 class="mb-3 text-gold">SecureDwell</h5>
          <p class="mb-0">Secure and verified properties across Telangana.</p>
        </div>
        <div class="col-md-6 text-center text-md-end">
          <p class="mb-0">&copy; <%= new Date().getFullYear() %> SecureDwell. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
