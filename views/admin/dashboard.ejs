<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - SecureDwell</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
  <style>
    :root {
      --gold-primary: #D4AF37;
      --gold-secondary: #CFB53B;
      --gold-light: #F8F4E3;
      --gold-dark: #85754d;
      --dark-bg: #1E1E2E;
      --card-shadow: 0 4px 12px rgba(0,0,0,0.1);
    }
    
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8f9fa;
    }
    
    .sidebar {
      height: 100vh;
      background: linear-gradient(135deg, var(--dark-bg) 0%, #2D2D44 100%);
      color: #fff;
      padding-top: 20px;
      min-width: 250px;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 100;
    }

    .sidebar h3 {
      color: var(--gold-primary);
      font-weight: bold;
      padding: 0 1.5rem;
      margin-bottom: 1.5rem;
    }

    .sidebar .nav-link {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1.1rem;
      padding: 0.8rem 1.5rem;
      border-radius: 0.5rem;
      margin: 0.2rem 0.5rem;
      transition: all 0.3s ease;
    }

    .sidebar .nav-link:hover, .sidebar .nav-link.active {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--gold-primary);
      transform: translateX(5px);
    }

    .sidebar .nav-link i {
      margin-right: 0.5rem;
      color: var(--gold-primary);
    }

    .content {
      margin-left: 250px;
      padding: 30px;
    }

    .card {
      border: none;
      border-radius: 12px;
      box-shadow: var(--card-shadow);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      overflow: hidden;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    }

    .property-status {
      font-weight: bold;
    }

    .card-img-top {
      object-fit: cover;
      height: 200px;
      transition: transform 0.5s ease;
    }
    
    .card:hover .card-img-top {
      transform: scale(1.05);
    }
    
    .btn-gold {
      background-color: var(--gold-primary);
      border-color: var(--gold-secondary);
      color: white;
      transition: all 0.3s ease;
    }
    
    .btn-gold:hover {
      background-color: var(--gold-dark);
      border-color: var(--gold-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
    
    .text-gold {
      color: var(--gold-primary) !important;
    }
    
    .badge-gold {
      background-color: var(--gold-primary);
      color: white;
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3 animate__animated animate__fadeInLeft">
      <h3><i class="bi bi-shield-lock me-2"></i>Admin</h3>
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link active" href="/admin/manage-listings">
            <i class="bi bi-list-check"></i> Manage Listings
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/logout">
            <i class="bi bi-box-arrow-right"></i> Logout
          </a>
        </li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="content w-100">
      <div class="container animate__animated animate__fadeIn">
        <h1 class="mb-3 text-gold"><i class="bi bi-speedometer2 me-2"></i>Welcome, Admin!</h1>
        <p class="text-muted mb-4">Use the cards below to manage property listings.</p>
        <hr class="mb-4">

        <div class="row">
          <% properties.forEach(property => { %>
            <div class="col-md-6 col-lg-4 mb-4 animate__animated animate__fadeIn">
              <div class="card h-100">
                <% if (property.images && property.images.length > 0) { %>
                  <img src="<%= property.images[0] %>" class="card-img-top" alt="Property Image">
                <% } else { %>
                  <img src="https://via.placeholder.com/400x200?text=No+Image" class="card-img-top" alt="No Image">
                <% } %>
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title text-gold"><%= property.title %></h5>
                  <p class="card-text text-muted"><%= property.description %></p>
                  <ul class="list-unstyled">
                    <li><strong>Price:</strong> ₹<%= property.price.toLocaleString() %></li>
                    <li><strong>Location:</strong> <%= property.location %></li>
                    <li class="property-status text-<%= property.status === 'Approved' ? 'success' : property.status === 'Rejected' ? 'danger' : 'warning' %> mt-2">
                      <span class="badge bg-<%= property.status === 'Approved' ? 'success' : property.status === 'Rejected' ? 'danger' : 'warning' %> p-2">
                        <i class="bi bi-<%= property.status === 'Approved' ? 'check-circle' : property.status === 'Rejected' ? 'x-circle' : 'clock' %>"></i>
                        Status: <%= property.status %>
                      </span>
                    </li>
                  </ul>
                  <div class="mt-auto">
                    <a href="/admin/property/<%= property._id %>" class="btn btn-primary btn-sm mb-2 w-100">
                      <i class="bi bi-eye me-1"></i>View Details
                    </a>
                    <div class="d-flex">
                      <a href="/admin/approve/<%= property._id %>" class="btn btn-success btn-sm me-2 flex-grow-1">
                        <i class="bi bi-check-lg me-1"></i>Approve
                      </a>
                      <a href="/admin/reject/<%= property._id %>" class="btn btn-danger btn-sm flex-grow-1">
                        <i class="bi bi-x-lg me-1"></i>Reject
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Card entrance animations with delay for staggered effect
      const cards = document.querySelectorAll('.card');
      cards.forEach((card, index) => {
        setTimeout(() => {
          card.classList.add('animate__animated', 'animate__fadeInUp');
        }, 100 + (index * 100));
      });
    });
  </script>
</body>
</html>